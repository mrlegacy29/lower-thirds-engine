# dependencies
node_modules/

# build output (installers, unpacked app)
# Anchored with a leading slash: a bare `release/` also matches
# vendor/macadam/build/Release/ and silently drops the native binary from the commit.
# git has NO inline comments — a trailing "# ..." on this line becomes part of the
# pattern, which is exactly how it stopped ignoring anything at all.
/release/
dist/

# logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# electron-builder cache
.cache/

# scratch probes
_probe_tmp.js
